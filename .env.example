# Copy to .env (local) or set as environment variables on the host. All optional.

# Where SQLite datasets, job state and exports live. Mount a persistent disk here in production.
UKA_DATA_DIR=/data

# Shared dashboard password (HTTP Basic auth; any username). STRONGLY recommended when deployed.
UKA_APP_PASSWORD=change-me-to-a-long-random-string

# VO rating list year to use (2026 list is live from 1 April 2026). Leave URL empty to auto-discover
# the newest epoch from https://voaratinglists.blob.core.windows.net/html/rlidata.htm
UKA_VOA_LIST_YEAR=2026
UKA_VOA_LIST_URL=

# Build missing datasets on first boot (VO ~5 min, Overture places ~10-60 min depending on bandwidth).
UKA_AUTO_IMPORT_ON_START=true
# Automatic updates: check daily whether new data has been published; install it overnight.
UKA_AUTO_REFRESH=true
UKA_REFRESH_CHECK_HOURS=24
# Local hours when downloads/imports may run (wraps past midnight, e.g. 22-04)
UKA_REFRESH_WINDOW=01-05

# Limits
UKA_MAX_RESULTS_PER_SEARCH=5000
UKA_MAX_CONCURRENT_JOBS=2
# Generated spreadsheets and job records are deleted after this many hours (VO licence: delete when no longer needed).
UKA_EXPORT_RETENTION_HOURS=72

# Companies House (owner names). Leave empty to read the public website; a free API key
# (https://developer.company-information.service.gov.uk/) is more reliable.
UKA_COMPANIES_HOUSE_API_KEY=

UKA_LOG_LEVEL=INFO
